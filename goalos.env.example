# GoalOS Environment Configuration
# Copy to /etc/goalos/goalos.env and fill in values.
# Never commit actual secrets to git.

# ============================================================================
# CORE
# ============================================================================
GOALOS_VERSION=0.5.0
GOALOS_LOG_LEVEL=INFO

# ============================================================================
# LLM PROVIDER
# ============================================================================
# Provider: openai_compatible (default), freellm, gemini
LLM_PROVIDER=openai_compatible

# Base URL for the OpenAI-compatible endpoint
# Examples:
#   FreeLLMAPI:   http://127.0.0.1:3001/v1
#   Ollama:       http://127.0.0.1:11434/v1
#   vLLM:         http://127.0.0.1:8000/v1
#   LM Studio:    http://127.0.0.1:1234/v1
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
LLM_BASE_URL=http://127.0.0.1:3001/v1

# API key (leave empty for local providers that don't require one)
LLM_API_KEY=

# Model name (must match what the provider serves)
LLM_MODEL=free-llm-small

# Request timeout in seconds
LLM_TIMEOUT=30

# Max retries for transient failures
LLM_MAX_RETRIES=3

# ============================================================================
# LIBRECHAT / API AUTHENTICATION
# ============================================================================
# API key for /v1/* endpoints (LibreChat uses this to authenticate)
GOALOS_API_KEY=

# Legacy name still accepted for backward compatibility:
# GOALOS_OPENWEBUI_API_KEY=

# ============================================================================
# CORS
# ============================================================================
# Comma-separated list of additional allowed origins
# GOALOS_CORS_ORIGINS=https://librechat.kvm.local

# ============================================================================
# SCHEDULER
# ============================================================================
GOALOS_SCHEDULER_ENABLED=1
GOALOS_SCHEDULER_INTERVAL=30
GOALOS_SCHEDULER_CLAIM_HORIZON=900

# ============================================================================
# DATABASE
# ============================================================================
# GOALOS_DATABASE_URL=sqlite:///./goalos.db

# ============================================================================
# GOOGLE INTEGRATIONS
# ============================================================================
# GA4
# GOALOS_GA4_PROPERTY_ID=
# GOALOS_GA4_CREDENTIALS_JSON=

# OAuth (Calendar, Drive, Gmail)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ============================================================================
# SOCIAL INTEGRATIONS
# ============================================================================

# Meta/Facebook/Instagram
# GOALOS_META_PAGE_ACCESS_TOKEN=
# GOALOS_META_APP_SECRET=
# GOALOS_META_PAGE_ID=

# LinkedIn
# GOALOS_LINKEDIN_ACCESS_TOKEN=
# GOALOS_LINKEDIN_ORG_ID=

# X/Twitter
# GOALOS_X_BEARER_TOKEN=

# Reddit
# GOALOS_REDDIT_ACCESS_TOKEN=

# ============================================================================
# COMMERCE / CRM
# ============================================================================

# WooCommerce
# GOALOS_WOO_URL=
# GOALOS_WOO_CONSUMER_KEY=
# GOALOS_WOO_CONSUMER_SECRET=

# Twenty CRM
# GOALOS_TWENTY_BASE_URL=
# GOALOS_TWENTY_API_KEY=
# GOALOS_TWENTY_WEBHOOK_SECRET=

# ============================================================================
# N8N AUTOMATION
# ============================================================================
# GOALOS_N8N_BASE_URL=
# GOALOS_N8N_API_KEY=

# ============================================================================
# WEB SEARCH
# ============================================================================
# GOALOS_SEARCH_PROVIDER=duckduckgo

# ============================================================================
# COMMUNICATIONS (Voice / SMS)
# ============================================================================
# COMMUNICATION_PRIMARY_PROVIDER=plivo
# COMMUNICATION_FALLBACK_PROVIDER=twilio

# Plivo
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_SOURCE_NUMBER=

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SOURCE_NUMBER=

# ============================================================================
# VOICE (STT/TTS)
# ============================================================================
# VOICE_STT_PROVIDER=deepgram
# VOICE_TTS_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# VOICE_LANGUAGE=en
# VOICE_TTS_VOICE=asteria
# VOICE_MAX_CALL_SECONDS=600

# ============================================================================
# WHATSAPP
# ============================================================================
# WHATSAPP_PROVIDER=wacrm (primary, Meta Business API via WACRM)
# WHATSAPP_PROVIDER=openwa (secondary, WhatsApp Web via OpenWA)
# WHATSAPP_PROVIDER=auto (use WACRM if configured, else OpenWA)
# WHATSAPP_AUTO_REPLY_ENABLED=true
# WHATSAPP_AGENT_SYSTEM_PROMPT=You are a helpful AI assistant for GoalOS.

# WACRM (primary — Meta WhatsApp Business API)
WACRM_API_URL=http://127.0.0.1:3000
WACRM_API_KEY=
WACRM_WEBHOOK_SECRET=

# OpenWA (secondary — WhatsApp Web)
# Set WHATSAPP_PROVIDER=openwa and these to connect GoalOS to OpenWA.
OPENWA_API_URL=http://127.0.0.1:2785
OPENWA_AUTH_TOKEN=
OPENWA_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (legacy, same as WACRM)
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_APP_SECRET=

# ============================================================================
# CAPACITY ADVISOR
# ============================================================================
# GOALOS_UPGRADE_RECOMMENDED_PLAN=KVM 4

# ============================================================================
# EXTERNAL CAPABILITIES — Phase 1
# ============================================================================

# OpenWA WhatsApp Service
# GOALOS_OPENWA_BASE_URL=http://localhost:5800
# GOALOS_OPENWA_API_KEY=

# Long-term Memory (TencentDB Agent Memory)
# GOALOS_MEMORY_BASE_URL=http://localhost:8080
# GOALOS_MEMORY_API_KEY=

# Crawl4AI Web Crawler (Python library or server)
# GOALOS_CRAWL4AI_BASE_URL=

# SearXNG Search Engine
# GOALOS_SEARXNG_BASE_URL=http://localhost:8888

# WACRM WhatsApp (dual-provider, primary)
# GOALOS_WACRM_BASE_URL=http://localhost:3000
# GOALOS_WACRM_API_KEY=

# Calling / Telephony (coming soon)
# GOALOS_CALLING_BASE_URL=
# GOALOS_CALLING_API_KEY=

# ============================================================================
# VIDEO PRODUCTION (OpenMontage)
# ============================================================================
# Path to the OpenMontage installation directory
# GOALOS_OPENMONTAGE_PATH=/opt/OpenMontage
# Directory where OpenMontage stores projects and outputs
# GOALOS_OPENMONTAGE_PROJECTS=/opt/openmontage-projects
# Default pipeline when auto-selecting (animated-explainer, cinematic, etc.)
# GOALOS_OPENMONTAGE_DEFAULT_PIPELINE=animated-explainer
# Maximum time (seconds) for a single production run
# GOALOS_OPENMONTAGE_TIMEOUT=1800

