# GoalOS environment configuration
# --------------------------------
# Copy to `.env` and fill in the values for your deployment:
#
#   cp env.example .env
#
# Secrets are never read from source code; they come from this file (or
# the container environment). Never commit the real `.env` file.

# --- Core application ------------------------------------------------
# SQLite database file. In Docker the image defaults to
# sqlite:////data/goalos.db (persisted on the goalos-data volume).
GOALOS_DATABASE_URL=sqlite:///./goalos.db

# API key that OpenWebUI must send as `Authorization: Bearer <key>`
# on every /v1/* request. Generate with something like:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GOALOS_OPENWEBUI_API_KEY=

# OpenWebUI origin used for CORS (e.g. http://openwebui.kvm.local:8080).
# Leave unset to keep only the localhost development origins.
OPENWEBUI_BASE_URL=

# Application log level: DEBUG | INFO | WARNING | ERROR (default INFO).
GOALOS_LOG_LEVEL=INFO

# --- LLM gateway (FreeLLMAPI / any OpenAI-compatible endpoint) -------
# Provider: freellm | openai_compatible
LLM_PROVIDER=openai_compatible
# Base URL of the OpenAI-compatible gateway. Accepts a bare origin
# (http://127.0.0.1:3001), a /v1 root (http://127.0.0.1:3001/v1), or the
# full endpoint (http://127.0.0.1:3001/v1/chat/completions).
LLM_BASE_URL=http://127.0.0.1:3001/v1
# API key for the gateway (FreeLLMAPI may not require one; leave blank if
# so). Never hard-coded — set here or in the container environment.
LLM_API_KEY=
# Model served by the gateway, e.g. openai-fast or free-llm-small.
LLM_MODEL=free-llm-small
# Optional overrides (defaults shown).
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=3

# --- Persisted scheduler ---------------------------------------------
GOALOS_SCHEDULER_ENABLED=1
GOALOS_SCHEDULER_INTERVAL=30
GOALOS_SCHEDULER_CLAIM_HORIZON=900

# --- Web research ----------------------------------------------------
# duckduckgo | (empty to disable)
GOALOS_SEARCH_PROVIDER=duckduckgo

# --- Twenty CRM (optional) -------------------------------------------
# REST API base: cloud https://api.twenty.com or self-hosted workspace.
GOALOS_TWENTY_BASE_URL=
GOALOS_TWENTY_API_KEY=
# HMAC secret validating Twenty webhook signatures.
GOALOS_TWENTY_WEBHOOK_SECRET=

# --- Gmail (optional) -------------------------------------------------
GOALOS_GMAIL_CLIENT_ID=
GOALOS_GMAIL_CLIENT_SECRET=
GOALOS_GMAIL_REFRESH_TOKEN=

# --- WooCommerce (optional) -------------------------------------------
GOALOS_WOO_URL=
GOALOS_WOO_CONSUMER_KEY=
GOALOS_WOO_CONSUMER_SECRET=

# --- Google Analytics 4 (optional) ------------------------------------
GOALOS_GA4_PROPERTY_ID=
GOALOS_GA4_CLIENT_EMAIL=
GOALOS_GA4_PRIVATE_KEY=

# --- Meta Ads (optional) ----------------------------------------------
GOALOS_META_ACCESS_TOKEN=
GOALOS_META_AD_ACCOUNT_ID=

# --- Social media providers (registered, not yet wired) ---------------
# These capability names resolve today but report Not Configured until
# real connectors are implemented; the variables are placeholders.
# GOALOS_META_PAGE_ACCESS_TOKEN=
# GOALOS_LINKEDIN_ACCESS_TOKEN=
# GOALOS_X_ACCESS_TOKEN=
# GOALOS_REDDIT_CLIENT_ID=
# GOALOS_REDDIT_CLIENT_SECRET=
# GOALOS_REDDIT_USERNAME=
# GOALOS_REDDIT_PASSWORD=

# --- Development (optional) -------------------------------------------
# Repository root used by development workers (KVM deployments).
# GOALOS_REPOSITORY=/opt/GoalOS
